function buildHawkSampleFrames(rows,cols){
  var msg="   FOREFRONTHAWK.COM   ";
  var totalFrames=120;
  var frames=[];
  for(var f=0;f<totalFrames;f++){
    var fColors=[],fLabels=[];
    var shift=f%msg.length;
    var baseHue=(f*6)%360;
    for(var r=0;r<rows;r++){
      for(var c=0;c<cols;c++){
        var charIdx=(c+shift+(r*3))%msg.length;
        var ch=msg.charAt(charIdx);
        var isLetter=ch!==" ";
        var hue=(baseHue+c*28+r*40)%360;
        var hex=isLetter?hslHex(hue,95,58):hslHex((hue+180)%360,70,18);
        fColors.push(hex);
        var lbl=r===0?(isLetter?("["+ch+"]"):"···"):(c<17?"FOREFRONTHAWK.COM".charAt(c):"🦅");
        fLabels.push(lbl);
      }
    }
    frames.push({colors:fColors,labels:fLabels,ring:hslHex(baseHue,95,55)});
  }
  return frames;
}

var HAWK_SAMPLE_FRAMES=buildHawkSampleFrames(S.rows,S.cols);

