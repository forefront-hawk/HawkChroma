function copyText(t,hex,label){return new Promise(function(res){
  var outText=(S.officePaste==="raw-hex"&&hex)?hex.replace("#","").toUpperCase():t;
  var richHtml=hex?buildOfficeHtml(hex,label,outText):null;

  function legacy(){
    try{
      if(richHtml){
        var dv=D.createElement("div");
        dv.innerHTML=richHtml;
        dv.style.cssText="position:fixed;left:-9999px;top:0;opacity:0";
        D.body.appendChild(dv);
        var rng=D.createRange();rng.selectNodeContents(dv);
        var sel=window.getSelection();sel.removeAllRanges();sel.addRange(rng);
        var ok1=D.execCommand("copy");
        sel.removeAllRanges();D.body.removeChild(dv);
        if(ok1){res(true);return}
      }
      var a=D.createElement("textarea");a.value=outText;a.setAttribute("readonly","");
      a.style.cssText="position:fixed;opacity:0;top:0";D.body.appendChild(a);
      a.select();a.setSelectionRange(0,outText.length);
      var ok=D.execCommand("copy");D.body.removeChild(a);res(!!ok);
    }catch(e){res(false)}
  }

  try{
    if(navigator.clipboard&&window.isSecureContext){
      if(richHtml&&typeof ClipboardItem!=="undefined"&&navigator.clipboard.write){
        var item=new ClipboardItem({
          "text/plain":new Blob([outText],{type:"text/plain"}),
          "text/html":new Blob([richHtml],{type:"text/html"})
        });
        navigator.clipboard.write([item]).then(function(){res(true)},function(){
          navigator.clipboard.writeText(outText).then(function(){res(true)},legacy);
        });
      }else{
        navigator.clipboard.writeText(outText).then(function(){res(true)},legacy);
      }
    }else{
      legacy();
    }
  }catch(e){legacy()}
})}

