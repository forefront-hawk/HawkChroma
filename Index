function downloadScriptCsv(filename,framesList){
  var n=S.rows*S.cols;
  var hdr=["frame","ring_hex"];
  for(var k=1;k<=n;k++)hdr.push("k"+k+"_hex");
  for(var m=1;m<=n;m++)hdr.push("k"+m+"_label");
  var lines=[hdr.join(",")];
  var maxF=Math.min(300,framesList.length);
  for(var f=0;f<maxF;f++){
    var fr=framesList[f];
    var row=[f+1,fr.ring||"#10B981"];
    for(var i=0;i<n;i++)row.push((fr.colors&&fr.colors[i])||"#10B981");
    for(var j=0;j<n;j++)row.push(csvEscape((fr.labels&&fr.labels[j])||""));
    lines.push(row.join(","));
  }
  var blob=new Blob([lines.join("\n")],{type:"text/csv;charset=utf-8"});
  var url=URL.createObjectURL(blob),a=D.createElement("a");
  a.href=url;a.download=filename;D.body.appendChild(a);a.click();D.body.removeChild(a);URL.revokeObjectURL(url);
}

$("dlTemplateScriptBtn").onclick=function(){
