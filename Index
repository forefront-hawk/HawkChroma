<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#07090E">
<title>HawkChroma</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&family=JetBrains+Mono:wght@500;700;800&family=Orbitron:wght@600;800&family=Press+Start+2P&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07090E;--panel:#12141A;--line:#262A34;--text:#F1F5F9;--mute:#94A3B8;--plate:#4B505C;--accent:#38BDF8;
  --deck1:#1A1C23;--deck2:#101216;--deck-border:#2D323E;--plate-border:#6E7485;
  --font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,Menlo,Consolas,monospace;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark
}
@media(prefers-color-scheme:light){:root[data-theme="auto"]{--bg:#E8EBF0;--panel:#F8FAFC;--line:#CBD5E1;--text:#0F172A;--mute:#475569;--plate:#8B93A3;--deck1:#CBD5E1;--deck2:#94A3B8;--deck-border:#64748B;color-scheme:light}}
:root[data-theme="light"]{--bg:#E8EBF0;--panel:#F8FAFC;--line:#CBD5E1;--text:#0F172A;--mute:#475569;--plate:#8B93A3;--deck1:#CBD5E1;--deck2:#94A3B8;--deck-border:#64748B;color-scheme:light}
:root[data-theme="midnight"]{--bg:#020617;--panel:#0F172A;--line:#1E293B;--text:#E2E8F0;--mute:#64748B;--plate:#1E293B;--deck1:#0F172A;--deck2:#020617;--deck-border:#334155}
:root[data-theme="cyberpunk"]{--bg:#0D0221;--panel:#19053B;--line:#4C1D95;--text:#F0ABFC;--mute:#C084FC;--plate:#2E1065;--deck1:#240046;--deck2:#10002B;--deck-border:#7E22CE}
:root[data-theme="emerald"]{--bg:#021612;--panel:#062821;--line:#0F4C3E;--text:#D1FAE5;--mute:#6EE7B7;--plate:#114237;--deck1:#06342B;--deck2:#021B16;--deck-border:#059669}
:root[data-theme="crimson"]{--bg:#160408;--panel:#280911;--line:#501322;--text:#FFE4E6;--mute:#FDA4AF;--plate:#3F101C;--deck1:#310B15;--deck2:#190409;--deck-border:#BE123C}
:root[data-theme="nord"]{--bg:#2E3440;--panel:#3B4252;--line:#4C566A;--text:#ECEFF4;--mute:#D8DEE9;--plate:#434C5E;--deck1:#3B4252;--deck2:#2E3440;--deck-border:#4C566A}
:root[data-theme="solarlight"]{--bg:#FDF6E3;--panel:#EEE8D5;--line:#D3CBB7;--text:#073642;--mute:#586E75;--plate:#93A1A1;--deck1:#E1DBCA;--deck2:#D3CBB7;--deck-border:#93A1A1;color-scheme:light}
:root[data-theme="solardark"]{--bg:#002B36;--panel:#073642;--line:#2AA198;--text:#93A1A1;--mute:#657B83;--plate:#0A4452;--deck1:#073642;--deck2:#00212B;--deck-border:#586E75}
:root[data-theme="mocha"]{--bg:#1E1E2E;--panel:#181825;--line:#313244;--text:#CDD6F4;--mute:#A6ADC8;--plate:#45475A;--deck1:#26273B;--deck2:#11111B;--deck-border:#585B70}
:root[data-theme="contrast"]{--bg:#000000;--panel:#0A0A0A;--line:#FFFFFF;--text:#FFFFFF;--mute:#E2E8F0;--plate:#1F1F1F;--deck1:#0A0A0A;--deck2:#000000;--deck-border:#FFFFFF}
:root[data-theme="matrix"]{--bg:#010902;--panel:#031606;--line:#00FF41;--text:#00FF41;--mute:#15803D;--plate:#042409;--accent:#00FF41;--deck1:#031A07;--deck2:#010802;--deck-border:#00FF41;--plate-border:#22C55E;--font:"JetBrains Mono",ui-monospace,monospace}
:root[data-theme="limewire"]{--bg:#f4fff4;--panel:#e0ffe0;--line:#99cc99;--text:#003300;--mute:#336633;--plate:#ccffcc;--deck1:#e0ffe0;--deck2:#ccffcc;--deck-border:#33cc33;color-scheme:light}
:root[data-theme="napster"]{--bg:#000033;--panel:#000044;--line:#333366;--text:#ccccff;--mute:#666699;--plate:#000022;--deck1:#000033;--deck2:#000011;--deck-border:#3333cc}
:root[data-theme="harrypotter"]{--bg:#2a0c0f;--panel:#3b1216;--line:#740001;--text:#eeba30;--mute:#d3a625;--plate:#1e080a;--deck1:#3b1216;--deck2:#1e080a;--deck-border:#eeba30}
:root[data-theme="winamp"]{--bg:#111122;--panel:#222233;--line:#444455;--text:#00ff00;--mute:#ff9900;--plate:#111111;--deck1:#222233;--deck2:#111122;--deck-border:#444455}
:root[data-theme="y2k"]{--bg:#e6e6fa;--panel:#d8bfd8;--line:#dda0dd;--text:#4b0082;--mute:#8a2be2;--plate:#c0c0c0;--deck1:#d8bfd8;--deck2:#c0c0c0;--deck-border:#87cefa;color-scheme:light}

/* Party Mode Full-UI Rainbow Styling */
body.party-mode{transition:none!important}
body.party-mode .bar,body.party-mode .side,body.party-mode .deck,body.party-mode .plate{border-color:var(--accent)!important;box-shadow:0 0 22px var(--accent)!important}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--text);font:500 13.5px/1.4 var(--font);min-height:100vh;overflow-x:hidden;transition:background-color .18s,color .18s}
.wrap{max-width:1180px;margin:0 auto;padding:10px;display:flex;flex-direction:column;gap:8px}
.bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:8px 10px}
.bar-head{display:flex;align-items:center;justify-content:space-between;width:100%;gap:8px}
.bar-body{display:flex;flex-wrap:wrap;align-items:center;gap:8px;width:100%;padding-top:6px;border-top:1px solid var(--line)}

button,select,input{font:inherit;color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:5px 9px;min-height:35px;touch-action:manipulation;cursor:pointer}
button:hover{filter:brightness(1.12)}
input[type=range]{padding:0;border:0;background:none;accent-color:var(--accent);min-height:auto}
input[type=color]{padding:2px;width:42px;min-height:32px;height:32px}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.brand{font-weight:800;font-size:16px;display:flex;align-items:center;gap:6px}.brand i{font-style:normal;color:var(--accent)}
.chip{font:600 11px var(--mono);padding:3px 8px;border-radius:8px;border:1px solid var(--line);color:var(--mute)}
.seg{display:flex;gap:2px;border:1px solid var(--line);border-radius:11px;padding:2px}
.seg button{border:0;min-height:29px;padding:2px 8px;background:none;color:var(--mute);font-weight:700;font-size:12px;border-radius:8px}
.seg button[aria-pressed="true"]{background:var(--accent);color:#04121C}
.readout{display:flex;align-items:center;gap:10px;flex:1 1 200px}
#sw{width:26px;height:26px;border-radius:7px;border:2px solid var(--text);flex:none}
#out{font:700 14px var(--mono)}
#toast{color:var(--mute);font-size:11.5px;min-height:15px}
label{display:flex;align-items:center;gap:5px;color:var(--mute);font-size:12.5px}

.deck{display:flex;flex-direction:column;gap:12px;background:linear-gradient(145deg,var(--deck1),var(--deck2));border:3px solid var(--deck-border);border-radius:22px;padding:12px}
@media(min-width:920px){.deck{flex-direction:row}}
.plate{flex:1;min-width:0;background:var(--plate);border:2px solid var(--plate-border);border-radius:16px;padding:10px;box-shadow:inset 0 3px 10px rgba(0,0,0,.55);transition:background-color .2s}
#banner{font:700 11.5px var(--mono);color:#FDE68A;margin:0 0 8px 2px}
#grid{display:grid;grid-template-columns:repeat(var(--cols,10),minmax(0,1fr));grid-auto-rows:var(--kh,76px);gap:var(--gp,6px)}
.key{position:relative;min-width:0;padding:3px;border-radius:10px;background:#1B1E26;border:2px solid var(--k);box-shadow:0 0 var(--glow-r,10px) var(--k);cursor:pointer;transition:transform .07s}
.key:active,.key.hit{transform:translateY(3px) scale(.96)}
.key.sel{outline:3px solid #fff;outline-offset:2px}
.cap{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:space-between;border-radius:7px;padding:4px 2px 3px;background:linear-gradient(180deg,#fff,#E2E8F0);color:#0F172A;overflow:hidden;box-shadow:inset 0 -3px 0 rgba(0,0,0,.2);font-family:var(--font)}
.cap b{display:block;width:100%;height:28%;max-height:16px;border-radius:4px;background:var(--k);border:1px solid rgba(0,0,0,.25)}
.cap span{font:800 clamp(7.5px,2.4vw,11.5px) var(--font);max-width:100%;overflow:hidden;white-space:nowrap}
.cap small{font:600 8.5px var(--mono);color:#64748B}
.dense .cap small{display:none}

.side{display:flex;flex-direction:column;align-items:center;gap:8px;background:var(--panel);border:2px solid var(--line);border-radius:16px;padding:12px;min-width:248px}
#ring{--rp:12px;border-radius:50%;padding:var(--rp);border:2px solid rgba(255,255,255,.3);background:var(--rb,#10B98160);box-shadow:0 0 30px var(--rc,#10B981)}
#ring.rainbow{--rp:calc(var(--dsn,150px)*.1);background:var(--rg)}
#ring.min{background:none;border-color:var(--rc)}
#knob{position:relative;width:calc(var(--dsn,150px) - 2*var(--rp));height:calc(var(--dsn,150px) - 2*var(--rp));border-radius:50%;background:radial-gradient(circle at 35% 35%,#323640,#14161B 78%);border:5px dashed #5C6270;touch-action:none;cursor:grab}
#knob.assign{border-color:#F43F5E;box-shadow:0 0 26px rgba(244,63,94,.7)}
#ring.rainbow #knob{background:#14161B;border:3px solid #0008}
#ring.min #knob{background:var(--rc);border:0;box-shadow:none}
#ring.min #notch{background:#000a}
#notch{width:max(5px,calc(var(--dsn,150px)*.045));height:calc(var(--dsn,150px)*.17);background:#fff;border-radius:4px;margin:6px auto 0}
#kinfo{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;pointer-events:none;color:#fff;font:700 calc(var(--dsn,150px)*.075) var(--mono)}
#angle{font-size:calc(var(--dsn,150px)*.1)}
#hue{width:100%;max-width:240px}
.side button{width:100%}
#assignBtn[aria-pressed="true"],#fsAssign[aria-pressed="true"]{background:#E11D48;border-color:#FB7185;color:#fff}
.hint{font-size:11.5px;color:var(--mute);text-align:center;margin:0}
.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;width:100%}
.subcard{background:rgba(0,0,0,0.18);border:1px solid var(--line);border-radius:11px;padding:8px 10px;width:100%;display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.subhead{font:800 11px var(--mono);text-transform:uppercase;color:var(--accent);letter-spacing:0.5px;margin-right:6px}

#grid[data-shape="square"] .key,#grid[data-shape="square"] .cap{border-radius:3px}
#grid[data-shape="oval"] .key,#grid[data-shape="oval"] .cap{border-radius:50%}
#grid[data-glow="off"] .key{box-shadow:none}
#grid[data-hex="off"] .cap small{display:none}
#grid[data-cap="flat"] .cap{background:var(--k);color:#fff;text-shadow:0 1px 2px #000a}
#grid[data-cap="flat"] .cap b{display:none}
#grid[data-cap="flat"] .cap small{color:#fff}
#grid[data-cap="dark"] .cap{background:#1E2028;color:#F1F5F9}
#grid[data-cap="dark"] .cap small{color:#94A3B8}
#grid[data-cap="ceramic"] .cap{background:linear-gradient(180deg,#FFFFFF,#F8FAFC);border:1px solid #CBD5E1;color:#020617}

.sl{flex:1 1 0;min-width:0}
.sl input{flex:1;min-width:0;width:100%}
.sl b{min-width:2.4em;text-align:right;font:700 12px var(--mono)}
#ro{justify-content:center;gap:14px}
#ro span{font:700 clamp(10px,1.8dvh,14px) var(--mono);white-space:nowrap}
#roSw{display:inline-block;width:14px;height:14px;border-radius:4px;border:1px solid var(--text)}

/* Full Screen Layout & Show/Hide Drawer */
#fsbar,#fsDrawer{display:none}
.fs .nf{display:none!important}
.fs .wrap{max-width:none;height:100vh;height:100dvh;padding:0;gap:.6dvh;justify-content:center;align-items:center}
.fs .deck{padding:0;border:0;background:none;width:98vw;flex:none;flex-direction:column;align-items:center;justify-content:center;gap:.5dvh}
.fs.dp-right .deck{flex-direction:row;gap:2vw}
.fs.dp-left .deck{flex-direction:row-reverse;gap:2vw}
.fs .plate{padding:0;border:0;background:none;box-shadow:none;flex:none;width:100%}
.fs.dp-right .plate,.fs.dp-left .plate{width:calc(98vw - var(--dsf) - 2vw)}
.fs #grid{width:100%;height:min(82dvh,calc(100dvh - var(--dv) - var(--ex)));margin:0 auto;grid-template-rows:repeat(var(--rows),minmax(0,1fr));grid-auto-rows:auto;gap:var(--gpf,1.2vmin)}
.fs #fsbar{display:flex;gap:1vw;width:98vw;height:4.6dvh;align-items:center}
.fs.hide-fsbar #fsbar{height:2.2dvh;opacity:0.35}
#fsbar button{flex:1 1 0;min-height:0;height:100%;padding:0 4px;font-weight:700;font-size:clamp(10px,1.9vh,14px);white-space:nowrap;overflow:hidden}
#fsMid{flex:1.4 1 0;display:flex;align-items:center;justify-content:center;touch-action:none;font:700 10px var(--mono);color:var(--mute);border:1px dashed var(--line);border-radius:8px;height:100%;cursor:pointer}
.fs #fsDrawer{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:6px;width:98vw;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:6px 10px;z-index:40}
.fs #fsDrawer[hidden]{display:none!important}
.fs.dp-hidden .side{display:none}
.fs .side{background:none;border:0;padding:0;min-width:0;width:auto;gap:0}
.fs #hue,.fs #assignBtn,.fs #themeBtn,.fs #sideFsBtn,.fs .hint{display:none}
.fs #ring{--rp:max(3px,calc(var(--dsf)*.04))}
.fs #ring.rainbow{--rp:calc(var(--dsf)*.12)}
.fs #knob{width:calc(var(--dsf) - 2*var(--rp));height:calc(var(--dsf) - 2*var(--rp));border-width:max(2px,calc(var(--dsf)*.02))}
.fs #notch{width:max(4px,calc(var(--dsf)*.035));height:calc(var(--dsf)*.14);margin-top:calc(var(--dsf)*.02)}
.fs #kinfo{font-size:calc(var(--dsf)*.075)}
.fs #angle{font-size:calc(var(--dsf)*.1)}
.fs.dsmall #mode,.fs.dsmall #dhex{display:none}
.fs #slBox,.fs #ro{background:none;border:0;padding:0;width:98vw;flex-wrap:nowrap;overflow:hidden}
.fs #slBox{height:4.2dvh}
.fs #ro{height:3.4dvh}
.fs .sl input{min-height:0;height:100%}
.fs .sl b,.fs .sl span{font-size:clamp(9px,1.6dvh,12px)}
.fs #roSw{width:1.8dvh;height:1.8dvh;min-width:0;min-height:0}
</style>
</head>
<body>
<div class="wrap">
  <!-- SECTION 1 (COLLAPSIBLE): Mode, App Profile, Format & Setup -->
  <header class="bar nf" id="sec1Bar">
    <div class="bar-head">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span class="brand">🦅 Hawk<i>Chroma</i></span>
        <span id="connChip" class="chip" style="color:var(--accent);border-color:var(--accent)">📋 Web Clipboard</span>
      </div>
      <div style="display:flex;align-items:center;gap:6px">
        <button id="partyBtn" aria-pressed="false" style="background:linear-gradient(90deg,#EF4444,#F59E0B,#10B981,#3B82F6,#EC4899);color:#fff;border-color:#fff;font-weight:800;text-shadow:0 1px 2px #000" title="Toggle Full-UI Rainbow Party Mode">🎉 Party Mode: Off</button>
        <button id="sec1CollapseBtn" class="chip" title="Collapse or expand Section 1">▼ Bar 1</button>
      </div>
    </div>

    <div class="bar-body" id="sec1Body">
      <div class="seg" id="cSeg" role="group" aria-label="Connection mode">
        <button data-v="windows" title="Web Clipboard">📋 Clipboard</button>
        <button data-v="chrome" title="Docked External Monitor BroadcastChannel">🌐 Chrome Dock</button>
      </div>

      <div class="seg" id="tSeg" role="group" aria-label="Target app">
        <button data-v="sheets">Excel/Sheets</button>
        <button data-v="word">Word/Outlook/Gmail</button>
        <button data-v="slides">Slides</button>
        <button data-v="design">Design</button>
        <button data-v="dmx">DMX</button>
        <button data-v="any">Any</button>
      </div>

      <div class="seg" id="fSeg" role="group" aria-label="Color format">
        <button data-v="hex">HEX</button>
        <button data-v="rgb">RGB</button>
        <button data-v="hsl">HSL</button>
        <button data-v="win">WIN/CSS</button>
      </div>

      <button id="modeBtn" style="margin-left:auto">Display: Auto</button>
      <button id="custBtn" aria-expanded="false" style="font-weight:700">Customize</button>
    </div>
  </header>

  <section id="panel" class="bar nf" hidden>
    <div class="subcard">
      <span class="subhead">1. Hardware &amp; Sound</span>
      <label>Rows <select id="rowsSel"></select></label>
      <label>Cols <select id="colsSel"></select></label>
      <label>Sound Profile
        <select id="sndTypeSel">
          <option value="cherry">Mechanical Blue/Brown (Click)</option>
          <option value="linear">Lubed Linear (Deep Thock)</option>
          <option value="bubble">Soft Bubble Pop</option>
          <option value="beeps">Retro 8-Bit Synth</option>
          <option value="scifi">Sci-Fi Energy Pluck</option>
          <option value="subtle">Subtle Whisper Tap</option>
        </select>
      </label>
      <label>Font Family
        <select id="fontSel">
          <option value="system">System Sans</option>
          <option value="calibri">Calibri (Office)</option>
          <option value="arial">Arial / Helvetica</option>
          <option value="inter">Inter Studio</option>
          <option value="serif">Times / Georgia Serif</option>
          <option value="mono">JetBrains / Consolas Mono</option>
          <option value="space">Space Grotesk</option>
          <option value="orbitron">Orbitron Cyber</option>
          <option value="pixel">8-Bit Pixel</option>
        </select>
      </label>
      <label>Plate Finish
        <select id="plateSel">
          <option value="theme">Match UI Theme</option>
          <option value="slate">Industrial Slate Gray</option>
          <option value="carbon">Carbon Fiber Dark</option>
          <option value="silver">Brushed Aluminum</option>
          <option value="brass">Anodized Brass Gold</option>
        </select>
      </label>
      <label>Idle Demo (FS) <select id="idleSel"></select></label>
    </div>

    <div class="subcard">
      <span class="subhead">2. UI Theme &amp; Colors</span>
      <label>UI Theme Preset
        <select id="uiThemeSel">
          <option value="dark">Obsidian Dark (Default)</option>
          <option value="light">Studio Daylight</option>
          <option value="auto">Auto (OS System)</option>
          <option value="midnight">Midnight OLED</option>
          <option value="cyberpunk">Cyberpunk Neon</option>
          <option value="matrix">Matrix Digital Code (Green CRT)</option>
          <option value="emerald">Emerald Matrix</option>
          <option value="crimson">Crimson Forged</option>
          <option value="nord">Nordic Frost</option>
          <option value="solarlight">Solarized Warm Light</option>
          <option value="solardark">Solarized Deep Teal</option>
          <option value="mocha">Catppuccin Mocha</option>
          <option value="contrast">High-Contrast Pro</option>
          <option value="limewire">Limewire P2P</option>
          <option value="napster">Napster MP3</option>
          <option value="harrypotter">Harry Potter</option>
          <option value="winamp">Winamp Classic</option>
          <option value="y2k">Y2K Silver</option>
        </select>
      </label>
      <label title="Custom Page Background">BG <input type="color" id="cBgPicker" value="#07090E"></label>
      <label title="Custom Panel Background">Panel <input type="color" id="cPanelPicker" value="#12141A"></label>
      <label title="Custom Font Text Color">Font <input type="color" id="cTextPicker" value="#F1F5F9"></label>
      <label title="Custom Switch Plate Color">Plate <input type="color" id="cPlatePicker" value="#4B505C"></label>
      <input id="uiThemeName" maxlength="18" placeholder="Custom UI theme name" style="width:155px">
      <button id="saveUiThemeBtn">Save UI Theme</button>
      <button id="delUiThemeBtn" hidden>Delete UI Theme</button>
    </div>

    <div class="subcard">
      <span class="subhead">3. Key &amp; Palette Editor</span>
      <button id="editBtn" aria-pressed="false">Edit keys: off</button>
      <div id="edBox" style="display:flex;align-items:center;gap:6px" hidden>
        <input id="edLabel" maxlength="8" size="8" aria-label="Key label" placeholder="Label">
        <input id="edColor" type="color" aria-label="Key color">
        <button id="edReset">Reset label</button>
      </div>
      <input id="tname" maxlength="20" placeholder="New key palette name" aria-label="Palette name" style="width:155px">
      <button id="tsave">Save as theme</button>
      <button id="tdel" hidden>Delete theme</button>
    </div>

    <div id="opts" class="subcard"></div>

    <div class="subcard">
      <span class="subhead">4. Config Snapshots &amp; CSV</span>
      <input id="cfgNameInput" maxlength="20" placeholder="Snapshot name" style="width:135px">
