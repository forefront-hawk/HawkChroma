SL.forEach(function(sl,i){sl.addEventListener("input",function(){var v=SL.map(function(x){return+x.value});
if(S.sl==="rgb"){var hx="#"+v.map(function(n){return n.toString(16).padStart(2,"0")}).join("").toUpperCase(),q=hsl(hx);S.h=q.h;S.s=q.s;S.l=q.l;S.hex=hx}
else{S.h=v[0];S.s=v[1];S.l=v[2]}
SV[i].textContent=sl.value;syncDial(true,true)});
sl.addEventListener("change",function(){if(!S.assign)announce(S.hex,"SLIDER",true,"SLIDER")})});

function applyLook(){
  var r=D.documentElement.style,b=D.body.classList,g=$("grid");
  r.setProperty("--accent",ACC[S.accent]||"#38BDF8");
  r.setProperty("--font",FONTS[S.font]||FONTS.system);
