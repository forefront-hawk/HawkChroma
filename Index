$("roRgb").textContent="rgb("+c.r+", "+c.g+", "+c.b+")";$("roHsl").textContent="hsl("+q.h+", "+q.s+"%, "+q.l+"%)"}
var SL=[0,1,2].map(function(i){return $("s"+i)}),SV=[0,1,2].map(function(i){return $("v"+i)}),SN=[0,1,2].map(function(i){return $("n"+i)});
function slLabels(){var rg=S.sl==="rgb",nm=rg?["R","G","B"]:["H","S","L"],mx=rg?[255,255,255]:[360,100,100],col=rg?["#EF4444","#22C55E","#3B82F6"]:["#A78BFA","#A78BFA","#A78BFA"];
for(var i=0;i<3;i++){SN[i].textContent=nm[i];SL[i].max=mx[i];SL[i].style.accentColor=col[i]}}
