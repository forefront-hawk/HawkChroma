function frame(t){
  if(!S.demo)return;
  if(t-S.t0>=S.demoSpeed){
    S.t0=t;
    S.phase=(S.phase+12)%360;
    var pat=S.demoPattern,n=cells.length;

    if(pat==="hawk-marquee"){
      if(HAWK_SAMPLE_FRAMES.length===0||HAWK_SAMPLE_FRAMES[0].colors.length!==n){
        HAWK_SAMPLE_FRAMES=buildHawkSampleFrames(S.rows,S.cols);
      }
      var hf=HAWK_SAMPLE_FRAMES[S.frameIdx%HAWK_SAMPLE_FRAMES.length];
      for(var i=0;i<n;i++){
        renderDemoCell(i,hf.colors[i]||"#38BDF8",hf.labels[i]);
      }
      setRing(hf.ring||"#38BDF8");
      S.frameIdx=(S.frameIdx+1)%HAWK_SAMPLE_FRAMES.length;
    }else if(pat==="custom-script"&&S.customFrames.length>0){
      var cf=S.customFrames[S.frameIdx%S.customFrames.length];
      for(var j=0;j<n;j++){
        var chx=(cf.colors&&cf.colors[j])||hslHex((S.phase+j*20)%360,90,55);
        var clb=(cf.labels&&cf.labels[j])||null;
        renderDemoCell(j,chx,clb);
      }
      setRing(cf.ring||cf.colors[0]||"#10B981");
      S.frameIdx=(S.frameIdx+1)%S.customFrames.length;
    }else if(pat==="cascade-horiz"){
      for(var i1=0;i1<n;i1++){
        var c1=i1%S.cols;
        renderDemoCell(i1,hslHex((S.phase+c1*36)%360,94,55),null);
      }
      setRing(hslHex(S.phase,95,55));
    }else if(pat==="cascade-vert"){
      for(var i2=0;i2<n;i2++){
        var r2=(i2/S.cols)|0,c2=i2%S.cols;
        renderDemoCell(i2,hslHex((S.phase*2+r2*75+c2*8)%360,92,54),null);
      }
      setRing(hslHex((S.phase*2)%360,95,55));
    }else if(pat==="cascade-diag"){
      for(var i3=0;i3<n;i3++){
        var r3=(i3/S.cols)|0,c3=i3%S.cols;
        renderDemoCell(i3,hslHex((S.phase+c3*28+r3*48)%360,92,55),null);
      }
      setRing(hslHex(S.phase,95,55));
    }else if(pat==="matrix-rain"){
      var mChars="012345789ZXYﾊﾐﾋｰｳｼﾅﾓﾆｻﾜﾂｵﾘ";
      for(var i4=0;i4<n;i4++){
        var r4=(i4/S.cols)|0,c4=i4%S.cols;
        var drop=((S.frameIdx+c4*3+r4*5)%8);
        var l4=drop===0?72:drop===1?52:drop===2?36:14;
        var mHex=hslHex(130,95,l4);
        var mCh=mChars.charAt((S.frameIdx+i4*7)%mChars.length);
        renderDemoCell(i4,mHex,mCh+" "+mCh);
      }
      setRing("#00FF41");
      S.frameIdx=(S.frameIdx+1)%300;
    }else if(pat==="plasma-spiral"){
      var midC=(S.cols-1)/2,midR=(S.rows-1)/2;
      for(var i5=0;i5<n;i5++){
        var r5=(i5/S.cols)|0,c5=i5%S.cols;
        var dist=Math.sqrt((c5-midC)*(c5-midC)+(r5-midR)*(r5-midR));
        var ang5=Math.atan2(r5-midR,c5-midC)*180/Math.PI;
        renderDemoCell(i5,hslHex((S.phase+dist*45+ang5+360)%360,94,55),null);
      }
      setRing(hslHex((S.phase+90)%360,95,55));
    }else{
      for(var i6=0;i6<n;i6++){
        var r6=(i6/S.cols)|0,c6=i6%S.cols;
        var dir=r6%2===0?1:-1;
        var activeCol=((S.frameIdx*dir)%S.cols+S.cols)%S.cols;
        var isHit=c6===activeCol||c6===(activeCol+1)%S.cols;
        var h6=r6%2===0?320:190;
        renderDemoCell(i6,hslHex(h6,95,isHit?62:20),null);
      }
      setRing(hslHex((S.frameIdx*25)%360,95,55));
      S.frameIdx=(S.frameIdx+1)%300;
    }
  }
  S.raf=requestAnimationFrame(frame);
}

