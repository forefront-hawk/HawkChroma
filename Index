    if(inQ){
      if(ch==='"'&&line[i+1]==='"'){cur+='"';i++}
      else if(ch==='"')inQ=false;
      else cur+=ch;
    }else{
      if(ch==='"')inQ=true;
      else if(ch===','){res.push(cur);cur=""}
      else cur+=ch;
    }
  }
  res.push(cur);return res;
}

