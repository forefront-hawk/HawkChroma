$("uploadScriptBtn").onclick=function(){$("scriptFileInput").click()};
$("scriptFileInput").onchange=function(e){
  var file=e.target.files&&e.target.files[0];if(!file)return;
  var reader=new FileReader();
  reader.onload=function(ev){
    try{
      var txt=String(ev.target.result||""),rows=txt.split(/\r?\n/);
      var n=S.rows*S.cols,parsed=[];
      for(var i=1;i<rows.length;i++){
        if(parsed.length>=300)break;
        var line=rows[i].trim();if(!line)continue;
        var cols=parseCsvLine(line);
        if(cols.length<2)continue;
        var ringHex=HEX.test(cols[1])?cols[1].toUpperCase():"#10B981";
        var fCols=[],fLbls=[];
        for(var k=0;k<n;k++){
          var chx=(cols[2+k]||"").trim().toUpperCase();
          fCols.push(HEX.test(chx)?chx:"#10B981");
          var clb=cols[2+n+k];
          fLbls.push(clb!=null&&clb!==""?String(clb).slice(0,8):null);
        }
        parsed.push({ring:ringHex,colors:fCols,labels:fLbls});
      }
      if(!parsed.length){toast("No valid frames found");return}
      S.customFrames=parsed;
      S.demoPattern="custom-script";
      $("scriptStatusChip").textContent="Loaded: "+file.name.slice(0,18)+" ("+parsed.length+" frames)";
      syncDemoPatternUi();save();
      stopDemo();startDemo(false);
      toast("Loaded Custom Script!");
    }catch(err){
      toast("Error parsing custom script CSV");
    }
    $("scriptFileInput").value="";
  };
  reader.readAsText(file);
};

