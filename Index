          var pts=val.split(" ");
          if(pts.length>=4)uithemes.push({n:k,bg:pts[0],panel:pts[1],text:pts[2],plate:pts[3]});
        }
      }
      if(keys.length)cfg.keys=keys;
      if(labels.length)cfg.labels=labels;
